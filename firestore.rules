rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: users
    // Document ID: uid
    // Fields: uid, name, email, role, teamId, photoURL, createdAt
    //
    // Collection: teams
    // Document ID: teamId
    // Fields: name, description, leaderId, members, createdAt
    //
    // Collection: clients
    // Document ID: clientId
    // Fields: name, phone, email, source, service, status, address, totalPrice, paidAmount, remainingAmount, createdAt
    //
    // Collection: projects
    // Document ID: projectId
    // Fields: clientId, name, serviceType, budget, status, startDate, endDate, notes, createdAt
    //
    // Collection: tasks
    // Document ID: taskId
    // Fields: projectId, clientId, assignedTo, title, description, priority, status, deadline, files, commentsCount, createdAt
    //
    // Collection: tasks/{taskId}/comments
    // Document ID: commentId
    // Fields: taskId, userId, userName, userPhoto, text, createdAt
    //
    // Collection: invoices
    // Document ID: invoiceId
    // Fields: clientId, projectId, amount, dueDate, status, items, createdAt
    //
    // Collection: expenses
    // Document ID: expenseId
    // Fields: category, amount, description, date, createdAt
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        ((exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
          request.auth.token.email == "abualsaud.uiux@gmail.com");
    }

    function isManager() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager' || isAdmin());
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{uid} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    match /teams/{teamId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }

    match /clients/{clientId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }

    match /projects/{projectId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }

    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow create: if isManager();
      allow update: if isAuthenticated() && (isManager() || request.auth.uid == resource.data.assignedTo);
      allow delete: if isManager();

      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
      }
    }

    match /invoices/{invoiceId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }

    match /expenses/{expenseId} {
      allow read: if isManager();
      allow write: if isManager();
    }

    match /chats/{chatId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow update, delete: if isAuthenticated() && request.auth.uid == resource.data.senderId;
      }
    }

    match /agencySettings/{id} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }

    match /calls/{callId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.receiverId);
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.callerId;
      allow update: if isAuthenticated() && (request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.receiverId);
      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.receiverId);
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
    }
  }
}
